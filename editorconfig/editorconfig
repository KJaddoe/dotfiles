# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# all files
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,resx,xml,java}]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab
indent_size = 4
