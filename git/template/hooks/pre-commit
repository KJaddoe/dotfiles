#!/bin/sh
# Enforces the format+lint half of the definition of done on staged files.
# Checks only — never rewrites what you staged. Skip with SKIP_HOOKS=1.
# A tool runs only when it is installed AND the project configures it, so this
# stays silent in repos that have not opted into a given toolchain.

[ -n "$SKIP_HOOKS" ] && exit 0

git diff --cached --check || exit 1

staged() {
    git diff --cached --name-only --diff-filter=ACM | grep -E "$1"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

any() {
    for f in "$@"; do
        [ -e "$f" ] && return 0
    done
    return 1
}

fail=0
report() {
    echo "pre-commit: $1" >&2
    fail=1
}

web=$(staged '\.(js|jsx|ts|tsx|mjs|cjs|css|scss|less|html|json|md|ya?ml)$')
if [ -n "$web" ] && have npx; then
    if any .prettierrc .prettierrc.json .prettierrc.json5 .prettierrc.yml .prettierrc.yaml \
        .prettierrc.toml .prettierrc.js .prettierrc.mjs .prettierrc.cjs \
        prettier.config.js prettier.config.mjs prettier.config.cjs ||
        grep -q '"prettier"[[:space:]]*:' package.json 2>/dev/null; then
        echo "$web" | xargs npx --no-install prettier --check >/dev/null 2>&1 ||
            report "prettier would reformat staged files"
    fi
fi

# eslintrc is not checked: it was removed in ESLint 9, which reads flat config only.
js=$(staged '\.(js|jsx|ts|tsx|mjs|cjs)$')
if [ -n "$js" ] && have npx &&
    any eslint.config.js eslint.config.mjs eslint.config.cjs eslint.config.ts; then
    echo "$js" | xargs npx --no-install eslint >/dev/null 2>&1 ||
        report "eslint reported problems in staged files"
fi

py=$(staged '\.py$')
if [ -n "$py" ]; then
    if have black && any pyproject.toml setup.cfg; then
        echo "$py" | xargs black --check >/dev/null 2>&1 ||
            report "black would reformat staged files"
    fi
    if have pylint && any pyproject.toml .pylintrc setup.cfg; then
        echo "$py" | xargs pylint --errors-only >/dev/null 2>&1 ||
            report "pylint reported errors in staged files"
    fi
fi

# True when the file's shebang names a shell shellcheck can parse (zsh cannot be).
shell_shebang() {
    first=$(head -n 1 "$1" 2>/dev/null)
    case "$first" in
    '#!'*) ;;
    *) return 1 ;;
    esac
    # intentional word splitting: the shebang's interpreter and its arguments
    # shellcheck disable=SC2086
    set -- ${first#\#!}
    [ "$#" -gt 0 ] || return 1
    interp=${1##*/}
    if [ "$interp" = env ] && [ "$#" -gt 1 ]; then
        interp=${2##*/}
    fi
    case "$interp" in
    sh | bash | dash | ksh) return 0 ;;
    esac
    return 1
}

sh_files=$(staged '\.(sh|bash)$')
extensionless=$(staged '(^|/)[^./]*$' | while IFS= read -r f; do
    [ -f "$f" ] && shell_shebang "$f" && echo "$f"
done)
sh_files=$(printf '%s\n%s\n' "$sh_files" "$extensionless" | grep -v '^$')

if [ -n "$sh_files" ] && have shellcheck; then
    echo "$sh_files" | xargs shellcheck >/dev/null 2>&1 ||
        report "shellcheck reported problems in staged files"
fi

# zsh has no formatter or linter that can parse it, so a syntax check is the only
# gate available — and a parse error in a sourced file breaks every new shell.
zsh_files=$(staged '\.zsh$|(^|/)\.?zshrc$|(^|/)\.?zshenv$')
if [ -n "$zsh_files" ] && have zsh; then
    echo "$zsh_files" | while IFS= read -r f; do
        [ -f "$f" ] || continue
        zsh -n "$f" 2>/dev/null || exit 1
    done || report "zsh reported a syntax error in staged files"
fi

lua=$(staged '\.lua$')
if [ -n "$lua" ]; then
    if have stylua && any .stylua.toml stylua.toml; then
        echo "$lua" | xargs stylua --check >/dev/null 2>&1 ||
            report "stylua would reformat staged files"
    fi
    # selene does not search parent directories, so the config is passed explicitly.
    # selene.toml is its own convention; selene/ is this repo's topic-folder layout.
    if have selene; then
        for conf in selene.toml selene/selene.toml; do
            [ -f "$conf" ] || continue
            echo "$lua" | xargs selene --config "$conf" >/dev/null 2>&1 ||
                report "selene reported problems in staged files"
            break
        done
    fi
fi

# csharpier, not `dotnet format`: it is what formats C# on save, and two formatters
# disagreeing over the same files would fail this gate on correctly-formatted code.
cs=$(staged '\.cs$')
if [ -n "$cs" ] && have csharpier && any .editorconfig; then
    echo "$cs" | xargs csharpier check >/dev/null 2>&1 ||
        report "csharpier would reformat staged files"
fi

docker=$(staged '(^|/)Dockerfile(\..*)?$')
if [ -n "$docker" ] && have hadolint; then
    echo "$docker" | xargs hadolint >/dev/null 2>&1 ||
        report "hadolint reported problems in staged files"
fi

md=$(staged '\.md$')
if [ -n "$md" ] && have markdownlint-cli2 && any .markdownlint.json .markdownlint.jsonc \
    .markdownlint.yaml .markdownlint.yml .markdownlint-cli2.jsonc .markdownlint-cli2.yaml; then
    echo "$md" | xargs markdownlint-cli2 >/dev/null 2>&1 ||
        report "markdownlint reported problems in staged files"
fi

yml=$(staged '\.ya?ml$')
if [ -n "$yml" ] && have yamllint && any .yamllint .yamllint.yml .yamllint.yaml; then
    echo "$yml" | xargs yamllint >/dev/null 2>&1 ||
        report "yamllint reported problems in staged files"
fi

notice() {
    echo "pre-commit: $1" >&2
}

if [ -n "$(staged '(^|/)(package|package-lock)\.json$')" ]; then
    notice "dependencies changed — run: npm audit"
fi

py_manifest=$(staged '(^|/)(requirements.*\.txt|Pipfile|poetry\.lock)$')
for f in $(staged '(^|/)pyproject\.toml$'); do
    grep -qE '^[[:space:]]*(dependencies|install_requires)' "$f" 2>/dev/null &&
        py_manifest="$py_manifest $f"
done
if [ -n "$py_manifest" ]; then
    notice "dependencies changed — run: pip-audit"
fi

if [ -n "$(staged '\.(csproj|fsproj)$|(^|/)Directory\.Packages\.props$')" ]; then
    notice "dependencies changed — run: dotnet list package --vulnerable --include-transitive"
fi

[ "$fail" -ne 0 ] && echo "pre-commit: fix, or SKIP_HOOKS=1 git commit … to bypass" >&2

exit $fail
