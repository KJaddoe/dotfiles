#!/bin/sh
# Enforces the format+lint half of the definition of done on staged files.
# Checks only — never rewrites what you staged. Skip with SKIP_HOOKS=1.
# A tool runs only when it is installed AND the project configures it, so this
# stays silent in repos that have not opted into a given toolchain.

[ -n "$SKIP_HOOKS" ] && exit 0

git diff --cached --check || exit 1

staged() {
	git diff --cached --name-only --diff-filter=ACM | grep -E "$1"
}

have() {
	command -v "$1" >/dev/null 2>&1
}

any() {
	for f in "$@"; do
		[ -e "$f" ] && return 0
	done
	return 1
}

fail=0
report() {
	echo "pre-commit: $1" >&2
	fail=1
}

js=$(staged '\.(js|jsx|ts|tsx|mjs|cjs)$')
if [ -n "$js" ] && have npx; then
	if any .prettierrc .prettierrc.json .prettierrc.yml .prettierrc.js prettier.config.js; then
		echo "$js" | xargs npx --no-install prettier --check >/dev/null 2>&1 ||
			report "prettier would reformat staged files"
	fi
	if any .eslintrc .eslintrc.json .eslintrc.js eslint.config.js eslint.config.mjs; then
		echo "$js" | xargs npx --no-install eslint >/dev/null 2>&1 ||
			report "eslint reported problems in staged files"
	fi
fi

py=$(staged '\.py$')
if [ -n "$py" ]; then
	if have black && any pyproject.toml setup.cfg; then
		echo "$py" | xargs black --check >/dev/null 2>&1 ||
			report "black would reformat staged files"
	fi
	if have pylint && any pyproject.toml .pylintrc setup.cfg; then
		echo "$py" | xargs pylint --errors-only >/dev/null 2>&1 ||
			report "pylint reported errors in staged files"
	fi
fi

sh_files=$(staged '\.(sh|bash)$')
if [ -n "$sh_files" ] && have shellcheck; then
	echo "$sh_files" | xargs shellcheck >/dev/null 2>&1 ||
		report "shellcheck reported problems in staged files"
fi

lua=$(staged '\.lua$')
if [ -n "$lua" ] && have stylua && any .stylua.toml stylua.toml; then
	echo "$lua" | xargs stylua --check >/dev/null 2>&1 ||
		report "stylua would reformat staged files"
fi

cs=$(staged '\.cs$')
if [ -n "$cs" ] && have dotnet && any .editorconfig; then
	dotnet format --verify-no-changes >/dev/null 2>&1 ||
		report "dotnet format would change staged files"
fi

[ "$fail" -ne 0 ] && echo "pre-commit: fix, or SKIP_HOOKS=1 git commit … to bypass" >&2

exit $fail
